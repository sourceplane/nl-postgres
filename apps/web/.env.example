# Local development. Copy to .env.local (git-ignored); never commit a value.
#
# DATABASE_URL is read by `pnpm --filter @app/web db:migrate:local` (which
# applies packages/db's migrations to a local Postgres) and by the app only
# when no Cloudflare context is available. Under `next dev` and `wrangler dev`
# the app reads the HYPERDRIVE binding from wrangler.jsonc instead (its
# localConnectionString — point both at the same database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unicorns
# Optional. Unset, the SQL is written by Workers AI, through the AI binding
# (`next dev` reaches it after `wrangler login`). Set, it is written by
# upstream's own model, OpenAI's gpt-5.4-mini, straight from OpenAI; `next
# dev` reads it from here, `wrangler dev` from .dev.vars.
# OPENAI_API_KEY=
# Optional: the site's public origin, which the page's Open Graph image link
# is resolved against. The Orun build sets it per environment
# (component.yaml); unset, it is http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
